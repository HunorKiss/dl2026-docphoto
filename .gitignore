# Root .gitignore. The per-lab infrastructure (Dockerfile, compose,
# requirements, lab-specific .gitignore) now lives under lab4/ and lab3/;
# this file protects the repository root so that data, caches, checkpoints
# and editor scratch never get committed from any lab directory.

# Data never goes in git. It is large, it is regenerable, and it makes the
# repository unusable for everyone else. Covers the repo root and every
# per-lab copy (lab3/data/..., lab4/data/...).
data/raw/*
data/work/*
**/data/raw/*
**/data/work/*
!**/data/**/.gitkeep

# Trained weights and checkpoints
models/*
**/models/*
!**/models/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.joblib
*.pkl

# Large array / cache formats, wherever they land
*.npy
*.npz

# Weights & Biases local runs
wandb/
**/wandb/

# Secrets
.env
**/.env

# Editor / OS / Jupyter scratch
.DS_Store
**/.DS_Store
**/.ipynb_checkpoints/
**/.virtual_documents/
__pycache__/
**/__pycache__/
*.pyc
